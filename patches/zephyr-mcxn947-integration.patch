-	/* One TX at a time in the current implementation */
-	ret = k_sem_take(&data->tx.tx_sem, K_NO_WAIT);
+	/* One TX at a time. TX completion releases this semaphore in the ISR.
+	 * Give an in-flight frame time to finish instead of dropping a competing
+	 * send (including TCP ACKs). Bound the wait if DMA stops responding.
+	 * Interrupt callers must remain non-blocking.
+	 */
+	ret = k_sem_take(&data->tx.tx_sem, k_is_in_isr() ? K_NO_WAIT : K_MSEC(100));
 	if (ret) {
 		LOG_DBG("%s TX busy, rejected thread %s", dev->name,
