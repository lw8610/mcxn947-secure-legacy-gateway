diff --git a/CMakeLists.txt b/CMakeLists.txt
index af167c49..780e82c5 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -78,7 +78,36 @@ if(CONFIG_SOC_SERIES_RW6XX)
     )
 endif()
 
-if(CONFIG_EXPORT_MCUX_ELS_PKC_TARGETS)
+# Zephyr integration for MCXN devices. The upstream NXP component already
+# contains the MCXN platform implementation, but its Zephyr glue historically
+# only selected RW61x. Use Zephyr's MCUX SDK-NG device headers and compile the
+# matching ELS/PKC platform layer for MCXN947.
+if(CONFIG_SOC_FAMILY_MCXN)
+    # Keep Zephyr's SDK-NG device headers ahead of the compatibility headers
+    # bundled with els_pkc.  Both trees contain MCXN947_cm33_core0.h, but only
+    # the SDK-NG copy matches the peripheral definitions used by Zephyr.
+    target_include_directories(McuxElsPkc BEFORE
+        PRIVATE
+            ${ZEPHYR_HAL_NXP_MODULE_DIR}/mcux/mcux-sdk-ng/drivers/common
+        PUBLIC
+            ${ZEPHYR_HAL_NXP_MODULE_DIR}/mcux/mcux-sdk-ng/devices/MCX/MCXN
+            ${ZEPHYR_HAL_NXP_MODULE_DIR}/mcux/mcux-sdk-ng/devices/MCX/MCXN/MCXN947
+            ${ZEPHYR_HAL_NXP_MODULE_DIR}/mcux/mcux-sdk-ng/devices/MCX/MCXN/MCXN947/drivers
+            ${CMAKE_CURRENT_SOURCE_DIR}/src/platforms/mcxn
+            ${CMAKE_CURRENT_SOURCE_DIR}/src/platforms/mcxn/inc
+            ${CMAKE_CURRENT_SOURCE_DIR}/includes/platform/mcxn
+    )
+
+    target_sources(McuxElsPkc
+        PRIVATE
+            ${CMAKE_CURRENT_SOURCE_DIR}/src/platforms/mcxn/mcux_els.c
+            ${CMAKE_CURRENT_SOURCE_DIR}/src/platforms/mcxn/mcux_pkc.c
+    )
+
+    target_link_libraries(McuxElsPkc PUBLIC zephyr_interface)
+endif()
+
+if(CONFIG_EXPORT_MCUX_ELS_PKC_TARGETS AND NOT DEFINED ZEPHYR_BASE)
 export(TARGETS McuxElsPkc
     FILE "${CMAKE_CURRENT_BINARY_DIR}/McuxElsPkcTargets.cmake"
     NAMESPACE McuxElsPkc::
